# Build outputs
/bin/
/dist/
/out/
*.exe
*.test
*.out

# Built binaries when produced at repo root by ad-hoc `go build`
/htools
/htoolsd
/htools-mcp
/htools-gui

# Go
vendor/
*.prof

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Local config
.env
.env.local
*.local.yaml

# Generated docs / coverage
coverage.out
coverage.html

# Stress harness outputs — fixtures + per-run timing logs.
# The committed baseline lives at docs/benchmarks/baseline.txt; everything
# else here is local scratch produced by `make stress`.
/docs/benchmarks/local-*.txt
/docs/benchmarks/stress-*.log

# Stray test fixtures that shouldn't be committed
/Heretic-Legion-Faction-Image-2.jpg

# Web frontend
web/node_modules/
# web/dist/ is the Svelte build output. Everything inside is ignored
# except .gitkeep, which we commit so `//go:embed all:dist` in web/webfs.go
# always finds a directory to embed (otherwise `go build ./...` would fail
# before the first `make web`). The user-visible fallback page lives at
# web/placeholder.html (sibling of dist/) and is embedded separately.
web/dist/*
!web/dist/.gitkeep
