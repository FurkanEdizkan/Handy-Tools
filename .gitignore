# Build outputs
/bin/
/dist/
*.exe
*.test
*.out

# Built TUI / server binaries when produced at repo root by ad-hoc `go build`
/htools
/htoolsd

# Go
vendor/
*.prof

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Local config
.env
.env.local
*.local.yaml

# Generated docs / coverage
coverage.out
coverage.html

# Mascot work-in-progress assets
internal/ui/mascot/art/*.draft.txt

# Web frontend
web/node_modules/
# web/dist/ is the Svelte build output. Everything inside is ignored
# except .gitkeep, which we commit so `//go:embed all:dist` in web/webfs.go
# always finds a directory to embed (otherwise `go build ./...` would fail
# before the first `make web`). The user-visible fallback page lives at
# web/placeholder.html (sibling of dist/) and is embedded separately.
web/dist/*
!web/dist/.gitkeep

# Chrome MV3 extension. Unlike web/dist, nothing embeds extension/dist into a
# Go binary, so the whole directory is ignored — no .gitkeep needed.
extension/node_modules/
extension/dist/
